# =============================================================================
# BIẾN MÔI TRƯỜNG BACKEND
# -----------------------------------------------------------------------------
# Sao chép file này thành `.env` rồi điền giá trị thật:
#   cp .env.example .env
#
# TUYỆT ĐỐI KHÔNG commit file `.env` lên repository.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Môi trường chạy ứng dụng: development | test | production
NODE_ENV=development

# Cổng HTTP mà backend lắng nghe
PORT=5000

# -----------------------------------------------------------------------------
# Cơ sở dữ liệu (bắt buộc)
# -----------------------------------------------------------------------------
# Chuỗi kết nối PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/online_course?schema=public"

# -----------------------------------------------------------------------------
# JWT (bắt buộc)
# -----------------------------------------------------------------------------
# Khoá bí mật ký token — TỐI THIỂU 32 KÝ TỰ.
# Sinh khoá ngẫu nhiên an toàn bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="thay-bang-chuoi-ngau-nhien-dai-toi-thieu-32-ky-tu"

# Thời hạn hiệu lực của token: 15m | 2h | 1d | 7d ...
JWT_EXPIRES_IN="1d"

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy.
# Dùng "*" để cho phép mọi origin (CHỈ nên dùng khi phát triển local).
CORS_ORIGIN="http://localhost:5173"

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Độ dài cửa sổ đếm request (phút)
RATE_LIMIT_WINDOW_MINUTES=15

# Số request tối đa mỗi IP trong một cửa sổ
RATE_LIMIT_MAX=300

# -----------------------------------------------------------------------------
# Cloudinary (tuỳ chọn — chỉ cần khi dùng chức năng upload ảnh/video thật)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
