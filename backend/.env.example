# =============================================================================
# BIẾN MÔI TRƯỜNG BACKEND
# -----------------------------------------------------------------------------
# Sao chép file này thành `.env` rồi điền giá trị thật:
#   cp .env.example .env
#
# TUYỆT ĐỐI KHÔNG commit file `.env` lên repository.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Môi trường chạy ứng dụng: development | test | production
NODE_ENV=development

# Cổng HTTP mà backend lắng nghe
PORT=5000

# -----------------------------------------------------------------------------
# Cơ sở dữ liệu (bắt buộc)
# -----------------------------------------------------------------------------
# Chuỗi kết nối PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/online_course?schema=public"

# -----------------------------------------------------------------------------
# JWT (bắt buộc)
# -----------------------------------------------------------------------------
# Khoá bí mật ký token — TỐI THIỂU 32 KÝ TỰ.
# Sinh khoá ngẫu nhiên an toàn bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="thay-bang-chuoi-ngau-nhien-dai-toi-thieu-32-ky-tu"

# Thời hạn hiệu lực của token: 15m | 2h | 1d | 7d ...
JWT_EXPIRES_IN="1d"

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy.
# Dùng "*" để cho phép mọi origin (CHỈ nên dùng khi phát triển local).
CORS_ORIGIN="http://localhost:5173"

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Độ dài cửa sổ đếm request (phút)
RATE_LIMIT_WINDOW_MINUTES=15

# Số request tối đa mỗi IP trong một cửa sổ
RATE_LIMIT_MAX=300

# -----------------------------------------------------------------------------
# Cloudinary (tuỳ chọn — chỉ cần khi dùng chức năng upload ảnh/video thật)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -----------------------------------------------------------------------------
# AI Chatbot — DRA (Dynamic Retrieval Augmentation)
# -----------------------------------------------------------------------------
# Toàn bộ nhóm biến này là TUỲ CHỌN. Nếu bỏ trống, ứng dụng vẫn chạy bình thường
# và chỉ riêng tính năng chatbot báo lỗi rõ ràng khi được gọi tới.

# Google Gemini — tạo vector embedding cho nội dung bài học
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# DeepSeek — sinh câu trả lời cho chatbot
# Lấy key tại: https://platform.deepseek.com
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# Bộ định tuyến DRA: điểm câu hỏi vượt ngưỡng này thì dùng chiến lược LCP
# (đọc toàn bộ khoá học), ngược lại dùng RAG (truy xuất đoạn liên quan).
ROUTER_LCP_THRESHOLD=3

# RAG — cấu hình chia đoạn và truy xuất
RAG_TOP_K=3              # Số đoạn liên quan nhất lấy ra cho mỗi câu hỏi
RAG_CHUNK_SIZE=1500      # Số ký tự mỗi đoạn
RAG_CHUNK_OVERLAP=200    # Số ký tự chồng lấn giữa hai đoạn liên tiếp

# LCP — giới hạn ký tự khi nhồi toàn bộ nội dung khoá học vào prompt
LCP_MAX_CHARS=200000
