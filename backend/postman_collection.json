{
  "info": {
    "name": "Khóa học trực tuyến - API Collection",
    "description": "API collection đồng bộ với code backend hiện tại. Base URL mặc định: http://localhost:5000/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "courseId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "lessonId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "reviewId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Đăng ký tài khoản",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Người Dùng Mới\",\n  \"email\": \"newuser@test.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Tạo tài khoản student mới."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 or 400', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Đăng nhập admin và tự lưu token vào adminToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('adminToken', res.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập Student (seed user1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@gmail.com\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Đăng nhập student và tự lưu token vào studentToken."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('studentToken', res.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🌐 Public",
      "item": [
        {
          "name": "Lấy danh sách danh mục",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories",
            "description": "Public endpoint."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lấy danh sách khóa học",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/courses",
            "description": "Public endpoint, trả về khóa học mới nhất trước."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Tìm kiếm khóa học gần đúng (backend)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/courses?q=react&category_id={{categoryId}}",
            "description": "Tìm kiếm gần đúng theo tiêu đề (q) và có thể lọc theo danh mục (category_id)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Xem chi tiết khóa học",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/courses/{{courseId}}",
            "description": "Public endpoint, 2 bài đầu mở khóa."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 404', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "🔒 Admin",
      "item": [
        {
          "name": "Danh mục",
          "item": [
            {
              "name": "Tạo danh mục",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Lập trình Mobile\",\n  \"description\": \"Các khóa học về mobile\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/admin/categories"
              }
            },
            {
              "name": "Sửa danh mục",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Tên danh mục đã sửa\",\n  \"description\": \"Mô tả mới\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": "{{baseUrl}}/admin/categories/{{categoryId}}"
              }
            },
            {
              "name": "Xóa danh mục",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": "{{baseUrl}}/admin/categories/{{categoryId}}"
              }
            }
          ]
        },
        {
          "name": "Khóa học",
          "item": [
            {
              "name": "Lấy chi tiết khóa học (admin)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": "{{baseUrl}}/admin/courses/{{courseId}}"
              }
            },
            {
              "name": "Tạo khóa học (multipart)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "title",
                      "value": "Khóa học React Native cơ bản",
                      "type": "text"
                    },
                    {
                      "key": "price",
                      "value": "699000",
                      "type": "text"
                    },
                    {
                      "key": "category_id",
                      "value": "{{categoryId}}",
                      "type": "text"
                    },
                    {
                      "key": "description",
                      "value": "Học React Native từ đầu",
                      "type": "text"
                    },
                    {
                      "key": "image",
                      "type": "file",
                      "src": ""
                    }
                  ]
                },
                "url": "{{baseUrl}}/admin/courses",
                "description": "Nếu không upload ảnh, bỏ trường image."
              }
            },
            {
              "name": "Sửa khóa học (multipart)",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "title",
                      "value": "Tên khóa học mới",
                      "type": "text"
                    },
                    {
                      "key": "price",
                      "value": "599000",
                      "type": "text"
                    },
                    {
                      "key": "category_id",
                      "value": "{{categoryId}}",
                      "type": "text"
                    },
                    {
                      "key": "description",
                      "value": "Mô tả mới",
                      "type": "text"
                    },
                    {
                      "key": "image",
                      "type": "file",
                      "src": ""
                    }
                  ]
                },
                "url": "{{baseUrl}}/admin/courses/{{courseId}}"
              }
            },
            {
              "name": "Xóa khóa học",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": "{{baseUrl}}/admin/courses/{{courseId}}"
              }
            }
          ]
        },
        {
          "name": "Bài giảng",
          "item": [
            {
              "name": "Thêm bài giảng (multipart)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "course_id",
                      "value": "{{courseId}}",
                      "type": "text"
                    },
                    {
                      "key": "title",
                      "value": "Bài 1: Giới thiệu",
                      "type": "text"
                    },
                    {
                      "key": "order_index",
                      "value": "1",
                      "type": "text"
                    },
                    {
                      "key": "video",
                      "type": "file",
                      "src": ""
                    }
                  ]
                },
                "url": "{{baseUrl}}/admin/lessons"
              }
            },
            {
              "name": "Sửa bài giảng (multipart)",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "key": "title",
                      "value": "Bài 1: Tên mới",
                      "type": "text"
                    },
                    {
                      "key": "order_index",
                      "value": "2",
                      "type": "text"
                    },
                    {
                      "key": "video",
                      "type": "file",
                      "src": ""
                    }
                  ]
                },
                "url": "{{baseUrl}}/admin/lessons/{{lessonId}}"
              }
            },
            {
              "name": "Xóa bài giảng",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": "{{baseUrl}}/admin/lessons/{{lessonId}}"
              }
            }
          ]
        },
        {
          "name": "Học viên",
          "item": [
            {
              "name": "Xem danh sách học viên (muộn nhất)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": "{{baseUrl}}/admin/students?sort=newest"
              }
            },
            {
              "name": "Xem danh sách học viên (sớm nhất)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": "{{baseUrl}}/admin/students?sort=oldest"
              }
            },
            {
              "name": "Xem chi tiết học viên",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": "{{baseUrl}}/admin/students/{{studentId}}"
              }
            }
          ]
        },
        {
          "name": "Đánh giá",
          "item": [
            {
              "name": "Xóa đánh giá",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": "{{baseUrl}}/admin/reviews/{{reviewId}}"
              }
            }
          ]
        },
        {
          "name": "Dashboard",
          "item": [
            {
              "name": "Lấy top 10 khóa học được mua nhiều nhất",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": "{{baseUrl}}/admin/dashboard/top-purchased-courses",
                "description": "Endpoint dashboard admin trả về top 10 khóa học theo số lượt mua đã thanh toán."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('Status code is 200', function () {",
                      "  pm.response.to.have.status(200);",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "🎓 Student",
      "item": [
        {
          "name": "Mua khóa học",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": {{courseId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/student/enroll"
          }
        },
        {
          "name": "Xem khóa học đã mua",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/student/my-courses"
          }
        },
        {
          "name": "Xem video bài giảng",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "url": "{{baseUrl}}/student/lessons/{{lessonId}}/video"
          }
        },
        {
          "name": "Đánh giá khóa học",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": {{courseId}},\n  \"rating\": 5,\n  \"comment\": \"Khóa học rất hay và dễ hiểu!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/student/reviews"
          }
        },
        {
          "name": "Cập nhật thông tin cá nhân",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Nguyễn Văn A đã cập nhật\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/student/profile"
          }
        },
        {
          "name": "Đổi mật khẩu",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{studentToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"123456\",\n  \"new_password\": \"newpassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/student/change-password"
          }
        }
      ]
    }
  ]
}
