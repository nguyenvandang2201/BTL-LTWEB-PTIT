    {
      "name": "🎓 Student",
      "description": "Các API dành cho học viên. Yêu cầu đăng nhập và header `Authorization: Bearer {{studentToken}}`.",
      "item": [
        {
          "name": "Mua khóa học (Enroll)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/student/enroll",
              "host": ["{{baseUrl}}"],
              "path": ["student", "enroll"]
            },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
