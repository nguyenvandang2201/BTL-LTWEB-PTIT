# =============================================================================
# BIẾN MÔI TRƯỜNG FRONTEND (Vite)
# -----------------------------------------------------------------------------
# Sao chép file này thành `.env` rồi điều chỉnh nếu cần:
#   cp .env.example .env
#
# Lưu ý: Vite chỉ đưa các biến có tiền tố `VITE_` vào mã nguồn client.
# Mọi giá trị ở đây đều LỘ CÔNG KHAI trong bundle — không đặt secret vào file này.
# =============================================================================

# URL gốc của backend API (bao gồm cả tiền tố /api)
VITE_API_URL="http://localhost:5000/api"
